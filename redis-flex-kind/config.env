# redis-flex-kind configuration.
# Every value can be overridden by exporting it before running the script, e.g.
#   sudo NVME_DEVICE=/dev/nvme2n1 DB_RAM=48GB ./redis-flex-kind.sh install
# Values left empty are auto-detected / auto-sized at runtime.

# ---- Tool versions -------------------------------------------------------------
: "${KIND_VERSION:=v0.33.0}"
# Redis Enterprise operator 8.2.0-18 supports Kubernetes 1.33-1.36.
: "${KIND_NODE_IMAGE:=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed}"
: "${KUBECTL_VERSION:=v1.36.4}"
: "${HELM_VERSION:=v4.3.0}"
: "${OPERATOR_CHART_VERSION:=8.2.0-18}"

# ---- NVMe / flash ----------------------------------------------------------------
# Pick ONE of the two modes:
#
# 1) Existing mount (you already formatted + mounted the NVMe, e.g. via fstab):
#      FLEX_DIR=/data/redis-flex
#    An EMPTY directory (created if missing) on a local, non-root ext4/xfs
#    filesystem. The script never formats, never edits fstab, installs no boot unit.
#
# 2) Managed raw disk (the script formats + mounts it):
#      NVME_DEVICE=/dev/nvme1n1
#    Formatted as ext4 (label $FLEX_FS_LABEL) only if it has no filesystem; a disk
#    with a foreign filesystem is refused unless FORCE_FORMAT=1. Mounted at
#    $FLEX_MOUNT via fstab, plus a boot unit that re-creates the filesystem if the
#    disk comes back blank (cloud instance store after stop/start).
#
# Neither set: managed mode on the single blank, unused NVMe disk if there is
# exactly one (e.g. EC2 instance store); otherwise the script stops and asks.
: "${FLEX_DIR:=}"
: "${NVME_DEVICE:=}"
: "${FORCE_FORMAT:=0}"
: "${FLEX_MOUNT:=/mnt/redis-flex}"
: "${FLEX_FS_LABEL:=redisflex}"
# Allow FLEX_DIR on the root filesystem (testing only; Flex needs a dedicated NVMe).
: "${ALLOW_ROOT_FS:=0}"

# ---- kind ------------------------------------------------------------------------
: "${KIND_CLUSTER_NAME:=redis-flex}"
# Host directory backing kind's default (local-path) StorageClass, used for the
# REC's persistent (config/metadata) volume. Kept off docker's overlayfs.
: "${PERSIST_HOST_DIR:=/var/lib/redis-flex-kind/persist}"
# Address the kind port mappings bind to on the host. 127.0.0.1 = local only
# (reach it with ssh -L). Use 0.0.0.0 or a private IP to expose to other hosts.
: "${LISTEN_ADDRESS:=127.0.0.1}"
: "${HOST_DB_PORT:=12000}"
: "${HOST_API_PORT:=9443}"
: "${HOST_UI_PORT:=8443}"

# ---- Redis Enterprise cluster ----------------------------------------------------
: "${NAMESPACE:=redis}"
: "${REC_NAME:=rec}"
# Empty = auto: CPU = nproc - 4 (operator, services rigger and k8s system pods
# request ~2.3 CPU), memory = 85% of host RAM.
: "${REC_CPU:=}"
: "${REC_MEMORY:=}"
: "${REC_PERSIST_SIZE:=100Gi}"
# Init container image that clears stale Flex shard data on REC pod start.
: "${FLASH_CLEANUP_IMAGE:=busybox:1.37}"
# Single node: RE's preStop hook tries to demote the node so another can take
# over, which never succeeds with nodes: 1, and the operator forces a 1-year
# termination grace period. During `rec`, a REC pod stuck terminating longer
# than this is force-deleted so rolling updates can finish.
: "${REC_FORCE_TERMINATE_AFTER_SECONDS:=180}"
# Empty = auto: 97% of the free space at the flash path.
: "${FLASH_DISK_SIZE:=}"
# Optional path to a Redis Enterprise license file. Empty = built-in trial
# (30 days, 4 shards, includes Flex). NOTE: on Kubernetes the RE cluster name is
# always <REC_NAME>.<NAMESPACE>.svc.cluster.local (hard-coded by the operator), so
# the license must be issued for that name (default: rec.redis.svc.cluster.local).
: "${REDIS_LICENSE_FILE:=}"

# ---- Database --------------------------------------------------------------------
: "${DB_NAME:=kvcache}"
: "${DB_PORT:=12000}"
# DB_MEMORY is RAM + flash total; DB_RAM is the RAM tier.
# Empty DB_MEMORY = auto: 79% of the free space at the flash path. Redis Enterprise keeps
# 12% of flash free (cluster policy bigstore_provision_node_threshold_p) and
# budgets extra flash for speedb space amplification; on an 870 GiB filesystem
# the largest DB it will provision is ~690 GiB total (64 GiB RAM + ~626 GiB flash).
: "${DB_MEMORY:=}"
: "${DB_RAM:=64GB}"
# Trial license allows 4 shards total.
: "${DB_SHARDS:=4}"
: "${DB_PERSISTENCE:=disabled}"
: "${DB_EVICTION:=allkeys-lru}"
